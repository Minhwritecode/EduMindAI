# Sao chép thành file .env — KHÔNG commit .env lên Git.
#   cp .env.example .env
# Flask (app.py) và Flutter đều đọc từ .env ở thư mục gốc repo.
# Không chia sẻ MONGO_URI / GEMINI_API_KEY công khai.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
GEMINI_API_KEY=
